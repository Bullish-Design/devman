{ pkgs, ... }:

{
  packages = [
    pkgs.uv
    pkgs.just
  ];

  languages.python = {
    enable = true;
    version = "{{ python_version }}";
  };

  {% if include_postgres %}
  services.postgres = {
    enable = true;
  };
  {% endif %}

  {% if include_redis %}
  services.redis = {
    enable = true;
  };
  {% endif %}

  enterShell = ''
    echo "Welcome to {{ project_name }}'s dev environment."
    echo "Python {{ python_version }} | uv $(uv --version | cut -d' ' -f2) | just $(just --version | cut -d' ' -f2)"
  '';
}
