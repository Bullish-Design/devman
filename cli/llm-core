#!/usr/bin/env python3
from __future__ import annotations

import json
import shutil
import sys
from pathlib import Path
from typing import List, Optional

import typer

REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT))

from lib import config, index, nvim_bridge, tmuxp  # noqa: E402

app = typer.Typer(add_completion=False, help="llm-core workspace orchestrator.")
index_app = typer.Typer(help="Index operations.")


def _select_workspace(entries: List[index.WorkspaceEntry]) -> index.WorkspaceEntry:
    lines = index.list_entries(entries)
    for idx, line in enumerate(lines, 1):
        typer.echo(f"[{idx}] {line}")
    choice = typer.prompt("Select workspace", default="1")
    selected = entries[int(choice) - 1]
    return selected


def _load_active_workspace(cli_roots: List[str]) -> config.WorkspaceConfig:
    devman_dir = config.find_devman_dir(Path.cwd())
    if not devman_dir:
        entries = index.refresh_index(config.resolve_roots(cli_roots))
        if not entries:
            raise typer.Exit("No workspaces found.")
        selected = _select_workspace(entries)
        devman_dir = Path(selected.workspace_root) / ".devman"
    return config.load_workspace_config(devman_dir)


def _ensure_tmux(config_data: config.WorkspaceConfig) -> None:
    if config_data.tmuxp_workspace and config_data.tmuxp_workspace.exists():
        tmuxp.ensure_tmuxp(config_data.tmuxp_workspace, config_data.tmuxp_session_name)
        session_name = config_data.tmuxp_session_name or config_data.name
        config.write_state(config_data, {"tmux_session": session_name})
        return

    session_name = config_data.tmuxp_session_name or config_data.name
    tmuxp.ensure_tmux_session(session_name, config_data.root)
    tmuxp.ensure_tmux_windows(session_name, config_data.root)
    config.write_state(config_data, {"tmux_session": session_name})


def _ensure_opencode_state(config_data: config.WorkspaceConfig) -> None:
    state = config.read_state(config_data)
    state["opencode"] = {
        "last_used": config_data.root.as_posix(),
    }
    config.write_state(config_data, state)


@app.callback(invoke_without_command=True)
def main(
    ctx: typer.Context,
    root: Optional[List[str]] = typer.Option(
        None, "--root", "-r", help="Workspace scan root (repeatable)."
    ),
) -> None:
    if ctx.invoked_subcommand is None:
        up(root or [])


@app.command()
def up(
    root: Optional[List[str]] = typer.Option(
        None, "--root", "-r", help="Workspace scan root (repeatable)."
    ),
) -> None:
    """Start or attach to a workspace."""
    config_data = _load_active_workspace(root or [])
    index.refresh_index(config.resolve_roots(root or []))
    _ensure_tmux(config_data)
    _ensure_opencode_state(config_data)


@app.command()
def down() -> None:
    """Stop services started by llm-core."""
    devman_dir = config.find_devman_dir(Path.cwd())
    if not devman_dir:
        raise typer.Exit("No workspace detected.")
    config_data = config.load_workspace_config(devman_dir)
    state = config.read_state(config_data)
    session_name = state.get("tmux_session")
    if session_name:
        typer.echo(f"Stopping tmux session {session_name}...")
        tmux_bin = shutil.which("tmux")
        if tmux_bin:
            import subprocess as sp

            sp.call([tmux_bin, "kill-session", "-t", session_name])
    else:
        typer.echo("No recorded tmux session to stop.")


@app.command()
def switch(
    query: str = typer.Argument(..., help="Workspace name, tag, or path."),
    root: Optional[List[str]] = typer.Option(
        None, "--root", "-r", help="Workspace scan root (repeatable)."
    ),
) -> None:
    """Switch to another workspace."""
    entries = index.refresh_index(config.resolve_roots(root or []))
    match = index.find_entry(entries, query)
    if not match:
        raise typer.Exit("No matching workspace found.")
    config_data = config.load_workspace_config(Path(match.workspace_root) / ".devman")
    _ensure_tmux(config_data)

    if config_data.nvim_listen and config_data.nvim_sessions_dir:
        session_path = config_data.nvim_sessions_dir / (
            config_data.nvim_default_session or "home.vim"
        )
        if session_path.exists():
            for cmd in nvim_bridge.build_session_command(session_path):
                nvim_bridge.remote_send(config_data.nvim_listen, cmd)


@app.command()
def open(
    query: str = typer.Argument(..., help="Workspace name, tag, or path."),
    root: Optional[List[str]] = typer.Option(
        None, "--root", "-r", help="Workspace scan root (repeatable)."
    ),
) -> None:
    """Open or attach to a workspace."""
    switch(query, root)


@index_app.command("status")
def index_status() -> None:
    """Show index cache status."""
    payload = index.load_index()
    if not payload:
        typer.echo("Index cache missing.")
        raise typer.Exit(code=1)
    typer.echo(json.dumps(payload, indent=2))


@index_app.command("rebuild")
def index_rebuild(
    root: Optional[List[str]] = typer.Option(
        None, "--root", "-r", help="Workspace scan root (repeatable)."
    ),
) -> None:
    """Force rebuild the index."""
    entries = index.rebuild_index(config.resolve_roots(root or []))
    for line in index.list_entries(entries):
        typer.echo(line)


@index_app.command("list")
def index_list(
    root: Optional[List[str]] = typer.Option(
        None, "--root", "-r", help="Workspace scan root (repeatable)."
    ),
) -> None:
    """List indexed workspaces."""
    entries = index.refresh_index(config.resolve_roots(root or []))
    for line in index.list_entries(entries):
        typer.echo(line)


@app.command()
def doctor() -> None:
    """Check external dependencies."""
    tools = ["tmux", "tmuxp", "nvim", "opencode"]
    for tool in tools:
        if shutil.which(tool):
            typer.echo(f"{tool}: ok")
        else:
            typer.echo(f"{tool}: missing")


@app.command()
def nvim(
    root: Optional[str] = typer.Argument(None, help="Workspace root to open."),
) -> None:
    """Launch Neovim with workspace session and listen socket."""
    workspace_root = Path(root) if root else Path.cwd()
    devman_dir = config.find_devman_dir(workspace_root)
    if not devman_dir:
        raise typer.Exit("No workspace found.")
    config_data = config.load_workspace_config(devman_dir)
    listen = config_data.nvim_listen or (config_data.root / ".devman" / ".state" / "nvim.sock")
    init = config_data.nvim_init if config_data.nvim_init and config_data.nvim_init.exists() else None
    nvim_bridge.launch_nvim(config_data.root, listen, init)

app.add_typer(index_app, name="index")

if __name__ == "__main__":
    app()
